# Face Verification Pipeline – Environment Variables
# Copy this file to .env and fill in your values

# Ethereum Sepolia RPC URL (get free from https://alchemy.com)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Ethereum wallet private key (with Sepolia testnet ETH)
# Get testnet ETH from https://sepoliafaucet.com
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# (Optional) SerpAPI key for Google Lens backup search
# Get free at https://serpapi.com (100 searches/month)
SERPAPI_KEY=
